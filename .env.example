ALFRED_API_KEY=your-secret-api-key-here
THINGS_MCP_URL=http://127.0.0.1:8100/mcp
ALFRED_HOST=0.0.0.0
ALFRED_PORT=8200
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
# Base URL the agent/skill executor uses to reach Alfred's own REST gateway.
# Keep loopback — bot and API run on the same host.
ALFRED_BASE_URL=http://127.0.0.1:8200/api/v1
# Comma-separated Telegram user IDs allowed to use the bot. Empty = allow all.
# Set to your own Telegram user ID to lock down natural-language Things edits.
TELEGRAM_ALLOWED_USER_IDS=
